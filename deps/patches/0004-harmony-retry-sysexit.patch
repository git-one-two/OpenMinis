diff --git a/src/execve/loader_retry.c b/src/execve/loader_retry.c
--- a/src/execve/loader_retry.c
+++ b/src/execve/loader_retry.c
@@ -3,6 +3,9 @@
  * The parent shell/Python process and its completed side effects stay intact.
  */
 #include <errno.h>
+#include <stdio.h>
+#include <sys/stat.h>
+#include <time.h>
 #include <fcntl.h>
 #include <signal.h>
 #include <stdint.h>
@@ -18,6 +21,35 @@
 #include "tracee/mem.h"
 #include "cli/note.h"
 
+void harmony_exec_diagnostic(Tracee *tracee, const char *stage, long code)
+{
+#ifdef ARCH_ARM64
+    const char *path = getenv("PROOT_EXEC_DIAG_FILE");
+    int saved_errno = errno, fd, length;
+    struct stat st;
+    char line[256];
+    if (path == NULL || path[0] == '\0') return;
+    fd = open(path, O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC | O_NOFOLLOW, 0600);
+    if (fd >= 0) {
+        if (fstat(fd, &st) == 0 && S_ISREG(st.st_mode) && st.st_size < 131072) {
+            length = snprintf(line, sizeof(line),
+                "time=%ld pid=%ld stage=%s code=%ld status=%d sysnum=%lu pc=%lx sp=%lx retries=%u\n",
+                (long)time(NULL), (long)tracee->pid, stage, code, tracee->status,
+                (unsigned long)get_sysnum(tracee, CURRENT),
+                (unsigned long)peek_reg(tracee, CURRENT, INSTR_POINTER),
+                (unsigned long)peek_reg(tracee, CURRENT, STACK_POINTER),
+                tracee->harmony_loader.retries);
+            if (length > 0 && (size_t)length < sizeof(line))
+                (void)write(fd, line, (size_t)length);
+        }
+        close(fd);
+    }
+    errno = saved_errno;
+#else
+    (void)tracee; (void)stage; (void)code;
+#endif
+}
+
 #ifdef ARCH_ARM64
 static bool recovery_enabled(const Tracee *tracee)
 {
@@ -170,10 +202,15 @@
     /* ORIGINAL will be snapshotted after this hook. Force the kernel's separate
      * NT_ARM_SYSTEM_CALL update even though both snapshots now say execve. */
     tracee->harmony_loader.force_sysnum = true;
+    /* EXIT normally has no sysexit. The replacement EXEC must deliver one,
+     * including across PTRACE_EVENT_EXEC, to transfer the new load script. */
+    tracee->restart_how = PTRACE_SYSCALL;
+    tracee->sysexit_pending = true;
     tracee->harmony_loader.restarting = true;
     tracee->harmony_loader.retry_exec_in_flight = true;
     tracee->harmony_loader.active = false;
     tracee->harmony_loader.retries++;
+    harmony_exec_diagnostic(tracee, "retry-start", tracee->harmony_loader.retries);
     note(tracee, WARNING, INTERNAL, "[proot-exec-loader-retry] pre-entry retry %u/3",
          tracee->harmony_loader.retries);
 #else
@@ -190,7 +227,11 @@
         tracee->harmony_loader.retry_exec_in_flight = false;
         tracee->harmony_loader.force_sysnum = false;
         tracee->harmony_loader.active = false;
-        note(tracee, WARNING, INTERNAL, "[proot-exec-loader-retry] retry exec failed; child stopped");
+        note(tracee, WARNING, INTERNAL, "[proot-exec-loader-retry] retry failed: result=%ld status=%d syscall=%lu pc=%lx; child stopped",
+             (long) peek_reg(tracee, CURRENT, SYSARG_RESULT), tracee->status,
+             (unsigned long) get_sysnum(tracee, ORIGINAL),
+             (unsigned long) peek_reg(tracee, CURRENT, INSTR_POINTER));
+        harmony_exec_diagnostic(tracee, "retry-failed", (long)peek_reg(tracee, CURRENT, SYSARG_RESULT));
         kill(tracee->pid, SIGKILL);
     }
 #else
