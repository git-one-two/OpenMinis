diff --git a/src/execve/loader_retry.c b/src/execve/loader_retry.c
new file mode 100644
--- /dev/null
+++ b/src/execve/loader_retry.c
@@ -0,0 +1,199 @@
+/* OpenMinis Harmony loader recovery, GPL-2.0-or-later.
+ * Re-exec only a failing ELF loader before its PR_SET_NAME commit boundary.
+ * The parent shell/Python process and its completed side effects stay intact.
+ */
+#include <errno.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/prctl.h>
+#include <talloc.h>
+#include <unistd.h>
+#include "execve/execve.h"
+#include "syscall/syscall.h"
+#include "syscall/sysnum.h"
+#include "tracee/reg.h"
+#include "tracee/mem.h"
+#include "cli/note.h"
+
+#ifdef ARCH_ARM64
+static bool recovery_enabled(const Tracee *tracee)
+{
+    const char *retry = getenv("PROOT_EXEC_LOADER_RETRY");
+    const char *verify = getenv("PROOT_VERIFY_REGSET");
+    return !tracee->is_aarch32 && tracee->qemu == NULL
+        && tracee->as_ptracee.ptracer == NULL
+        && retry != NULL && strcmp(retry, "1") == 0
+        && verify != NULL && strcmp(verify, "1") == 0;
+}
+
+static bool guest_overlaps_loader(const Tracee *tracee, const LoadInfo *load)
+{
+    size_t i;
+    if (load == NULL) return false;
+    if (load->mappings != NULL) {
+        for (i = 0; i < talloc_array_length(load->mappings); i++) {
+            word_t start = load->mappings[i].addr;
+            word_t size = load->mappings[i].length;
+            if (start > UINT64_MAX - size || (size != 0
+                && start < tracee->harmony_loader.text_end
+                && start + size > tracee->harmony_loader.text_start))
+                return true;
+        }
+    }
+    return guest_overlaps_loader(tracee, load->interp);
+}
+
+static int find_loader_text(const ElfHeader *header, const ProgramHeader *program, void *data)
+{
+    Tracee *tracee = data;
+    word_t start, size;
+    if (PROGRAM_FIELD(*header, *program, type) != PT_LOAD
+        || !(PROGRAM_FIELD(*header, *program, flags) & PF_X))
+        return 0;
+    start = PROGRAM_FIELD(*header, *program, vaddr);
+    size = PROGRAM_FIELD(*header, *program, memsz);
+    /* Reject ambiguous/discontiguous code ranges and overflow. */
+    if (tracee->harmony_loader.text_end != 0 || size == 0
+        || start > UINT64_MAX - size)
+        return -EINVAL;
+    tracee->harmony_loader.text_start = start;
+    tracee->harmony_loader.text_end = start + size;
+    return 0;
+}
+#endif
+
+void harmony_loader_prepare(Tracee *tracee, const char *loader_path)
+{
+#ifdef ARCH_ARM64
+    ElfHeader header;
+    int fd, status;
+    bool restarting = tracee->harmony_loader.restarting;
+    tracee->harmony_loader.restarting = false;
+    tracee->harmony_loader.active = false;
+    tracee->harmony_loader.initial_sp = 0;
+    tracee->harmony_loader.text_start = 0;
+    tracee->harmony_loader.text_end = 0;
+    if (!restarting) {
+        tracee->harmony_loader.retries = 0;
+        TALLOC_FREE(tracee->harmony_loader.raw_path);
+    }
+    if (!recovery_enabled(tracee) || tracee->load_info == NULL)
+        return;
+    /* Preserve shebang AT_EXECFN/comm semantics when retrying its interpreter. */
+    if (restarting && tracee->harmony_loader.raw_path != NULL) {
+        char *raw = talloc_strdup(tracee->load_info, tracee->harmony_loader.raw_path);
+        if (raw == NULL) return;
+        tracee->load_info->raw_path = raw;
+    } else {
+        tracee->harmony_loader.raw_path = talloc_strdup(tracee, tracee->load_info->raw_path);
+        if (tracee->harmony_loader.raw_path == NULL) return;
+    }
+    fd = open_elf(loader_path, &header);
+    if (fd < 0) return;
+    /* Fixed-address 64-bit ARM loader only; never guess an ASLR load bias. */
+    status = -EINVAL;
+    if (IS_CLASS64(header) && ELF_FIELD(header, type) == ET_EXEC
+        && ELF_FIELD(header, machine) == 183)
+        status = iterate_program_headers(tracee, fd, &header, find_loader_text, tracee);
+    close(fd);
+    if (status >= 0 && guest_overlaps_loader(tracee, tracee->load_info))
+        status = -EINVAL;
+    if (status < 0) {
+        tracee->harmony_loader.text_start = 0;
+        tracee->harmony_loader.text_end = 0;
+    }
+#else
+    (void) tracee; (void) loader_path;
+#endif
+}
+
+void harmony_loader_arm(Tracee *tracee, word_t initial_sp)
+{
+#ifdef ARCH_ARM64
+    tracee->harmony_loader.retry_exec_in_flight = false;
+    tracee->harmony_loader.initial_sp = initial_sp;
+    tracee->harmony_loader.active = recovery_enabled(tracee)
+        && tracee->harmony_loader.text_end != 0;
+#else
+    (void) tracee; (void) initial_sp;
+#endif
+}
+
+void harmony_loader_enter(Tracee *tracee)
+{
+#ifdef ARCH_ARM64
+    word_t pc, number, argc, terminator, sp;
+    struct user_regs_struct saved;
+    bool changed;
+    if (!tracee->harmony_loader.active || !recovery_enabled(tracee))
+        return;
+    pc = peek_reg(tracee, CURRENT, INSTR_POINTER);
+    if (pc < tracee->harmony_loader.text_start || pc >= tracee->harmony_loader.text_end) {
+        tracee->harmony_loader.active = false;
+        return;
+    }
+    number = get_sysnum(tracee, CURRENT);
+    /* This is the actual vendored loader's last syscall before BRANCH. */
+    if (number == PR_prctl && peek_reg(tracee, CURRENT, SYSARG_1) == PR_SET_NAME) {
+        tracee->harmony_loader.active = false;
+        return;
+    }
+    /* Failed attempts must not leak the loader's read-only ELF fd across exec. */
+    if (number == PR_openat) {
+        poke_reg(tracee, SYSARG_3, peek_reg(tracee, CURRENT, SYSARG_3) | O_CLOEXEC);
+        return;
+    }
+    if (number != PR_exit || peek_reg(tracee, CURRENT, SYSARG_1) != 182
+        || tracee->harmony_loader.retries >= 3 || tracee->load_info == NULL)
+        return;
+    sp = tracee->harmony_loader.initial_sp;
+    if (sp == 0 || read_data(tracee, &argc, sp, sizeof(argc)) < 0
+        || argc == 0 || argc > 4096 || sp > UINT64_MAX - (argc + 3) * sizeof(word_t)
+        || read_data(tracee, &terminator, sp + (argc + 1) * sizeof(word_t), sizeof(terminator)) < 0
+        || terminator != 0)
+        return;
+    saved = tracee->_regs[CURRENT];
+    changed = tracee->_regs_were_changed;
+    if (set_sysarg_path(tracee, tracee->load_info->user_path, SYSARG_1) < 0) {
+        tracee->_regs[CURRENT] = saved;
+        tracee->_regs_were_changed = changed;
+        return;
+    }
+    /* Kernel-built argv/envp are still intact above the loader's script/frame.
+     * Use the already-expanded interpreter path, so shebang argv isn't doubled. */
+    poke_reg(tracee, SYSARG_2, sp + sizeof(word_t));
+    poke_reg(tracee, SYSARG_3, sp + (argc + 2) * sizeof(word_t));
+    set_sysnum(tracee, PR_execve);
+    /* ORIGINAL will be snapshotted after this hook. Force the kernel's separate
+     * NT_ARM_SYSTEM_CALL update even though both snapshots now say execve. */
+    tracee->harmony_loader.force_sysnum = true;
+    tracee->harmony_loader.restarting = true;
+    tracee->harmony_loader.retry_exec_in_flight = true;
+    tracee->harmony_loader.active = false;
+    tracee->harmony_loader.retries++;
+    note(tracee, WARNING, INTERNAL, "[proot-exec-loader-retry] pre-entry retry %u/3",
+         tracee->harmony_loader.retries);
+#else
+    (void) tracee;
+#endif
+}
+
+void harmony_loader_fail_retry(Tracee *tracee)
+{
+#ifdef ARCH_ARM64
+    /* An injected exec that fails must never return into __builtin_unreachable
+     * after the old loader's EXIT instruction. Terminate this child instead. */
+    if (tracee->harmony_loader.retry_exec_in_flight) {
+        tracee->harmony_loader.retry_exec_in_flight = false;
+        tracee->harmony_loader.force_sysnum = false;
+        tracee->harmony_loader.active = false;
+        note(tracee, WARNING, INTERNAL, "[proot-exec-loader-retry] retry exec failed; child stopped");
+        kill(tracee->pid, SIGKILL);
+    }
+#else
+    (void) tracee;
+#endif
+}
