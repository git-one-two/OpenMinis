+#if defined(ARCH_ARM64)
+/* [T-harmony-regset-verify] Opt-in stopped-tracee write verification.
+ * Independent iovecs prevent a syscall-number pointer being reused for GPRs.
+ * NT_ARM_SYSTEM_CALL contains an int (including -1), not a 64-bit word.
+ * Verification cannot prove that resume preserves the written registers.
+ */
+static int push_verified_arm64_regs(pid_t pid, void *expected, size_t size,
+                                   int sysnum, bool write_sysnum)
+{
+    unsigned char observed[34 * sizeof(uint64_t)];
+    int attempt;
+    if (size != sizeof(observed)) {
+        errno = EINVAL;
+        return -1;
+    }
+    for (attempt = 0; attempt < 3; attempt++) {
+        struct iovec general = { expected, size };
+        struct iovec number = { &sysnum, sizeof(sysnum) };
+        struct iovec check = { observed, sizeof(observed) };
+        int read_sysnum = 0;
+        struct iovec check_number = { &read_sysnum, sizeof(read_sysnum) };
+        if (ptrace(PTRACE_SETREGSET, pid, NT_PRSTATUS, &general) < 0)
+            return -1;
+        if (write_sysnum &&
+            ptrace(PTRACE_SETREGSET, pid, NT_ARM_SYSTEM_CALL, &number) < 0)
+            return -1;
+        if (ptrace(PTRACE_GETREGSET, pid, NT_PRSTATUS, &check) < 0)
+            return -1;
+        if (check.iov_len != sizeof(observed)) {
+            errno = EIO;
+            return -1;
+        }
+        if (write_sysnum) {
+            if (ptrace(PTRACE_GETREGSET, pid, NT_ARM_SYSTEM_CALL, &check_number) < 0)
+                return -1;
+            if (check_number.iov_len != sizeof(read_sysnum)) {
+                errno = EIO;
+                return -1;
+            }
+        }
+        /* pstate is normalized by the kernel: compare x0..x30, sp and pc. */
+        if (memcmp(observed, expected, 33 * sizeof(uint64_t)) == 0 &&
+            (!write_sysnum || read_sysnum == sysnum))
+            return 0;
+    }
+    errno = EIO; /* Never silently continue after unverified rewrites. */
+    return -1;
+}
+#endif
 
